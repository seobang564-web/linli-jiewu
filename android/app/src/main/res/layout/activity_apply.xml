<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include android:id="@+id/top" layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/Card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                <ImageView android:id="@+id/thumb" android:layout_width="64dp" android:layout_height="64dp" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/title" style="@style/T.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" />
                    <LinearLayout android:id="@+id/tags" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card" android:orientation="vertical" android:padding="18dp">
                <LinearLayout style="@style/SectionLabel" android:layout_marginBottom="12dp">
                    <TextView style="@style/T.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/apply_due" />
                    <TextView style="@style/T.En" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="12sp" android:text="@string/apply_due_en" />
                </LinearLayout>
                <LinearLayout android:id="@+id/dayRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
                <LinearLayout android:id="@+id/timeRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_clock" />
                    <TextView android:id="@+id/dueSummary" style="@style/T.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card" android:orientation="vertical" android:padding="18dp">
                <LinearLayout style="@style/SectionLabel" android:layout_marginBottom="12dp">
                    <TextView style="@style/T.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/apply_note" />
                    <TextView style="@style/T.En" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="12sp" android:text="@string/apply_note_en" />
                </LinearLayout>
                <EditText android:id="@+id/note" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_textarea" android:gravity="top" android:importantForAutofill="no" android:inputType="textMultiLine" android:maxLength="200" android:minLines="3" android:padding="12dp" android:text="@string/apply_note_default" android:textColor="@color/ink" android:textSize="14.5sp" />
                <TextView android:id="@+id/noteCounter" style="@style/T.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="4dp" android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                style="@style/T"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gutter"
                android:layout_marginEnd="@dimen/gutter"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_notice_lime"
                android:lineSpacingMultiplier="1.45"
                android:padding="16dp"
                android:text="@string/apply_notice"
                android:textColor="@color/lime_ink"
                android:textSize="12.5sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/bottomBar" style="@style/BottomBar">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:text="@string/apply_submit" />
    </LinearLayout>
</LinearLayout>
