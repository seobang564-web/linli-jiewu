<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.95" android:duration="120" android:interpolator="@interpolator/ease_out_expo" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.95" android:duration="120" android:interpolator="@interpolator/ease_out_expo" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="260" android:interpolator="@interpolator/spring_soft" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="260" android:interpolator="@interpolator/spring_soft" />
        </set>
    </item>
</selector>
