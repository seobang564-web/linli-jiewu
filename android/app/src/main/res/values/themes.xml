<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LinliJiewu.Base" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/olive</item>
        <item name="colorPrimaryVariant">@color/olive_deep</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/olive</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorControlActivated">@color/olive</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/sub</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Linli.Anim.Push</item>
        <item name="materialAlertDialogTheme">@style/Linli.AlertDialog</item>
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.FilledBox</item>
    </style>

    <style name="Theme.LinliJiewu" parent="Theme.LinliJiewu.Base" />

    <!-- 发布页：从底部弹出，后面的页面缩小变暗 -->
    <style name="Theme.LinliJiewu.Sheet">
        <item name="android:windowAnimationStyle">@style/Linli.Anim.Sheet</item>
    </style>

    <style name="Linli.Anim.Push" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/push_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/push_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/pop_exit</item>
    </style>

    <style name="Linli.Anim.Sheet" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/sheet_up</item>
        <item name="android:activityOpenExitAnimation">@anim/scale_back</item>
        <item name="android:activityCloseEnterAnimation">@anim/scale_forward</item>
        <item name="android:activityCloseExitAnimation">@anim/sheet_down</item>
    </style>

    <style name="Linli.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/olive</item>
        <item name="shapeAppearanceOverlay">@style/Linli.Shape.Dialog</item>
    </style>
    <style name="Linli.Shape.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- 加载层：背景变暗 -->
    <style name="Linli.LoadingDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/Linli.Anim.Fade</item>
    </style>
    <style name="Linli.Anim.Fade" parent="">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
